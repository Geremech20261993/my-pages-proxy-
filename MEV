    constructor(address _primarySearcher, address _owner) {
        require(_primarySearcher != address(0), "Invalid searcher");
        require(_owner != address(0), "Invalid owner");
        
        PRIMARY_SEARCHER = _primarySearcher;
        OWNER = _owner;
        
        // Initialize transient storage for authorization
        assembly {
            tstore(AUTHORIZATION_TRANSIENT_SLOT, _primarySearcher)
            tstore(REVOCATION_TRANSIENT_SLOT, 0)
        }
        
        minProfitThreshold = 1e18; // 1 WETH minimum profit
        validatorTip = 0;
        flashLoanActive = false;
    }
    
    // ========================================================================
    // ZERO-LATENCY SEARCHER AUTHORIZATION (EIP-1153 TLOAD)
    // ========================================================================
    
    modifier onlyAuthorizedSearcher() {
        assembly {
            let searcher := tload(AUTHORIZATION_TRANSIENT_SLOT)
            let revoked := tload(REVOCATION_TRANSIENT_SLOT)
            
            // Check if caller is primary searcher AND not revoked
            if iszero(and(
                eq(caller(), searcher),
                iszero(revoked)
            )) {
                mstore(0x00, 0x82b42900) // UnauthorizedCaller()
                revert(0x1c, 0x04)
            }
        }
        _;
    }
    
    modifier onlyWhileFlashLoan() {
        if (!flashLoanActive) {
            revert FlashLoanRepaymentFailed();
        }
        _;
    }
    
    // ========================================================================
    // PRIORITY FEE CAP & GAS OPTIMIZATION
    // ========================================================================
    
    function _computeEffectiveGasPrice() internal view returns (uint256) {
        uint256 txGasPrice = tx.gasprice;
        uint256 cappedPrice = block.basefee + MAX_PRIORITY_FEE_CAP;
        
        assembly {
            // EffectiveGasPrice = min(tx.gasprice, block.basefee + MAX_PRIORITY_FEE_CAP)
            if gt(txGasPrice, cappedPrice) {
                txGasPrice := cappedPrice
            }
        }
        
        return txGasPrice;
    }
    
    function _computeTotalGasCost(uint256 startGas) internal view returns (uint256) {
        uint256 gasUsed = startGas - gasleft();
        uint256 effectivePrice = _computeEffectiveGasPrice();
        
        assembly {
            // TotalGasCost = gasUsed * effectivePrice
            // No double-counting, accurate execution cost
        }
        
        return gasUsed * effectivePrice;
    }
    
    // ========================================================================
    // BOUNDS-VALIDATED BALANCER V2 CALLDATA DECODING
    // ========================================================================
    
    function receiveFlashLoan(
        address[] memory tokens,
        uint256[] memory amounts,
        uint256[] memory feeAmounts,
        bytes memory userData
    ) external override onlyWhileFlashLoan nonReentrant {
        require(msg.sender == BALANCER_VAULT, "Invalid vault");
        
        uint256 startGas = gasleft();
        uint256 initialBalance = IERC20(WETH).balanceOf(address(this));
        
        // Execute multi-hop arbitrage with bounds-checked calldata
        uint256 finalBalance = _executeMultiHopArbitrage(
            userData,
            initialBalance
        );
        
        // Compute gas cost with priority fee cap
        uint256 totalGasCost = _computeTotalGasCost(startGas);
        uint256 flashFee = feeAmounts[0];
        
        // Calculate gross profit
        uint256 grossProfit = finalBalance - (initialBalance + flashFee + totalGasCost);
        
        // Validate profitability after validator tip
        if (grossProfit < minProfitThreshold + validatorTip) {
            revert UnprofitableExecutionWithGasLoss();
        }
        
        // Repay flash loan
        IERC20(tokens[0]).safeApprove(BALANCER_VAULT, amounts[0] + feeAmounts[0]);
        
        flashLoanActive = false;
    }
    
    // ========================================================================
    // MULTI-HOP ARBITRAGE EXECUTION ENGINE
    // ========================================================================
    
    function _executeMultiHopArbitrage(
        bytes memory userData,
        uint256 initialAmount
    ) internal returns (uint256) {
        // Mandatory arbitrage cycle: WETH -> USDT -> DAI -> USDC -> WETH
        // Packed calldata: 4 hops × 105 bytes = 420 bytes
        
        // Bounds check: minimum calldata size for 4 hops
        if (userData.length < 420) {
            revert InvalidCalldataSize();
        }
        
        uint256 currentAmount = initialAmount;
        address currentToken = WETH;
        
        // Hop 1: WETH -> USDT
        currentAmount = _executeHop(
            userData,
            0,
            currentToken,
            USDT,
            currentAmount
        );
        
        // Hop 2: USDT -> DAI
        currentAmount = _executeHop(
            userData,
            1,
            USDT,
            DAI,
            currentAmount
        );
        
        // Hop 3: DAI -> USDC
        currentAmount = _executeHop(
            userData,
            2,
            DAI,
            USDC,
            currentAmount
        );
        
        // Hop 4: USDC -> WETH (completing cycle)
        currentAmount = _executeHop(
            userData,
            3,
            USDC,
            WETH,
            currentAmount
        );
        
        return currentAmount;
    }
    
    function _executeHop(
        bytes memory userData,
        uint256 hopIndex,
        address tokenIn,
        address tokenOut,
        uint256 amountIn
    ) internal returns (uint256) {
        uint256 offset = hopIndex * HOP_SIZE;
        
        // Extract hop parameters from packed calldata
        uint8 dexType;
        address target;
        bytes memory extraData;
        
        assembly {
            // Load dex type (1 byte)
            let dataPtr := add(userData, 0x20)
            dexType := byte(0, mload(add(dataPtr, add(offset, DEX_TYPE_OFFSET))))
            
            // Load target address (32 bytes, but we only use 20)
            target := mload(add(dataPtr, add(offset, TARGET_OFFSET)))
            
            // Load extra data pointer (32 bytes)
            extraData := mload(add(dataPtr, add(offset, EXTRA_DATA_OFFSET)))
        }
        
        // Calculate minimum output with slippage protection (50 bps)
        uint256 minOut = (amountIn * (BPS_DIVISOR - MAX_SLIPPAGE_BPS)) / BPS_DIVISOR;
        
        // Route to appropriate DEX executor
        if (dexType == DEX_UNISWAP_V2) {
            return _executeUniswapV2Swap(target, tokenIn, tokenOut, amountIn, minOut);
        } else if (dexType == DEX_UNISWAP_V3) {
            return _executeUniswapV3Swap(target, tokenIn, tokenOut, amountIn, minOut);
        } else if (dexType == DEX_UNISWAP_V4) {
            return _executeUniswapV4Swap(tokenIn, tokenOut, amountIn, minOut, extraData);
        } else if (dexType == DEX_BALANCER_V2) {
            return _executeBalancerSwap(target, tokenIn, tokenOut, amountIn, minOut);
        } else if (dexType == DEX_CURVE) {
            return _executeCurveSwap(target, tokenIn, tokenOut, amountIn, minOut);
        } else {
            revert("Unknown DEX type");
        }
    }
    
    // ========================================================================
