    function setMinProfitThreshold(uint256 _minProfit) external {
        require(msg.sender == PRIMARY_SEARCHER, "Unauthorized");
        minProfitThreshold = _minProfit;
    }
    
    function setValidatorTip(uint256 _tip) external {
        require(msg.sender == PRIMARY_SEARCHER, "Unauthorized");
        validatorTip = _tip;
    }
    
    function revokeSearcherAuthorization() external {
        require(msg.sender == PRIMARY_SEARCHER, "Unauthorized");
        assembly {
            tstore(REVOCATION_TRANSIENT_SLOT, 1)
        }
    }
    
