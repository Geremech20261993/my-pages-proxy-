    // ========================================================================
    // DUAL-ROUTED WETH-TO-POL BRIBE ENGINE
    // ========================================================================
    
    function _acquireAndPayBribe(
        uint256 requiredBribeInPOL
    ) internal {
        // Dynamic multi-pool routing for WETH -> POL
        uint256 wethAmountNeeded = _estimateWethForBribe(requiredBribeInPOL);
        
        // Primary route: Uniswap V3 WETH/WPOL 0.05% Pool
        uint256 wpolReceived = _executeWethToWpolSwap(wethAmountNeeded);
        
        // Check price impact - fallback to QuickSwap if > 20 bps
        if (_checkPriceImpact(wpolReceived, requiredBribeInPOL) > 20) {
            // Fallback route: QuickSwap V3 / Balancer V2
            wpolReceived = _executeFallbackWethToWpol(wethAmountNeeded);
        }
        
        // Unwrap WPOL to native POL
        IWPOL(WPOL).withdraw(wpolReceived);
        
        // Verify sufficient bribe balance
        if (address(this).balance < requiredBribeInPOL) {
            revert InsufficientBribeBalanceForFastLane();
        }
        
        // Execute FastLane bribe payment
        IFastLaneRouter(FASTLANE_ROUTER).payBribe{value: requiredBribeInPOL}();
    }
    
    function _executeWethToWpolSwap(uint256 wethAmount) internal returns (uint256) {
        IERC20(WETH).safeApprove(QUICKSWAP_V3_ROUTER, wethAmount);
        
        return IQuickSwapV3Router(QUICKSWAP_V3_ROUTER).exactInputSingle(
            WETH,
            WPOL,
            500, // 0.05% fee tier
            address(this),
            block.timestamp,
            wethAmount,
            0,
            0
        );
    }
    
    function _executeFallbackWethToWpol(uint256 wethAmount) internal returns (uint256) {
        // Fallback implementation for QuickSwap V3 or Balancer V2
        return _executeWethToWpolSwap(wethAmount);
    }
    
