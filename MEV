        address[] memory path = new address[](2);
        path[0] = tokenIn;
        path[1] = tokenOut;
        
        IERC20(tokenIn).safeApprove(router, amountIn);
        
        uint256[] memory amounts = IUniswapV2Router(router)
            .swapExactTokensForTokens(
                amountIn,
                minOut,
                path,
                address(this),
                block.timestamp
            );
        
        return amounts[1];
    }
    
