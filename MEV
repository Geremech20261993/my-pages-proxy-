            let success := call(gas(), OWNER, balance, 0, 0, 0, 0)
            if iszero(success) {
                mstore(0x00, 0x90b8e31d) // NativeTransferFailed()
                revert(0x1c, 0x04)
            }
        }
    }
    
    function sweepToken(address token, uint256 amount) external onlyAuthorizedSearcher nonReentrant {
        IERC20(token).safeTransfer(OWNER, amount);
    }
    
    // ========================================================================
    // FLASH LOAN INITIATION
    // ========================================================================
    
    function initiateArbitrage(
        uint256 loanAmount,
        bytes memory arbitrageCalldata
    ) external onlyAuthorizedSearcher nonReentrant {
        // Set flash loan flag
        flashLoanActive = true;
        
        // Initiate Balancer V2 flash loan (zero fee)
        address[] memory tokens = new address[](1);
        tokens[0] = WETH;
        
        uint256[] memory amounts = new uint256[](1);
        amounts[0] = loanAmount;
        
        IVault(BALANCER_VAULT).flashLoan(
            this,
            tokens,
            amounts,
            arbitrageCalldata
        );
        
        // After flash loan completion, execute bribe payment
        uint256 profit = IERC20(WETH).balanceOf(address(this)) - loanAmount;
        if (profit > minProfitThreshold) {
            uint256 bribeAmount = (profit * 10) / 100; // 10% of profit as bribe
            _acquireAndPayBribe(bribeAmount);
        }
    }
    
    // ========================================================================
